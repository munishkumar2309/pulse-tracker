<?xml version="1.0" encoding="utf-8"?>
<!-- StepsWidget (2×2). Values are set in StepsWidget.java. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_steps"
        android:textColor="@color/widget_steps"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/steps_value"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:autoSizeMaxTextSize="32sp"
        android:autoSizeMinTextSize="14sp"
        android:autoSizeTextType="uniform"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:text="@string/widget_none"
        android:textColor="@color/widget_ink"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/steps_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progress="0"
        android:progressBackgroundTint="@color/widget_track"
        android:progressTint="@color/widget_steps" />

    <TextView
        android:id="@+id/steps_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_none"
        android:textColor="@color/widget_muted"
        android:textSize="12sp" />
</LinearLayout>
